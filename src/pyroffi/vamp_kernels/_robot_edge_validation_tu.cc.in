// Per-robot translation unit compiled by cricket's JIT at runtime.
//
// pyroffi substitutes the @PLACEHOLDERS@ (simple string replacement, not CMake
// configure) and hands the result to `cricket.jit.ClangCompiler`.  The two
// `extern "C"` accessors give the JIT session stable, unmangled symbol names to
// look up; each returns the address of an XLA FFI custom-call handler that JAX
// registers with `jax.ffi.register_ffi_target(..., platform="cpu")`.
//
// Placeholders:
//   @ROBOT_HEADER@  absolute path to the cricket-generated robot header
//   @FFI_HEADER@    absolute path to _edge_validation_ffi.hh
//   @ROBOT_TYPE@    fully-qualified robot struct, e.g. vamp::robots::Panda
//   @ROBOT_NAME@    lowercase token used as the handler symbol suffix

#include "@ROBOT_HEADER@"

#define VAMP_JAX_ROBOT @ROBOT_TYPE@
#define VAMP_JAX_ROBOT_NAME @ROBOT_NAME@

#include "@FFI_HEADER@"

#undef VAMP_JAX_ROBOT
#undef VAMP_JAX_ROBOT_NAME

extern "C" void *pyroffi_get_validate_configs() noexcept
{
    return reinterpret_cast<void *>(&validate_configs_@ROBOT_NAME@);
}

extern "C" void *pyroffi_get_validate_edges() noexcept
{
    return reinterpret_cast<void *>(&validate_edges_@ROBOT_NAME@);
}

extern "C" void *pyroffi_get_project_configs() noexcept
{
    return reinterpret_cast<void *>(&project_configs_@ROBOT_NAME@);
}
