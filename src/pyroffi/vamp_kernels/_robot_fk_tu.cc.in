// Per-robot translation unit for the VAMP end-effector FK FFI handler.
//
// Mirrors _robot_edge_validation_tu.cc.in: pyroffi substitutes the
// @PLACEHOLDERS@ (plain string replacement) and hands the result to cricket's
// JIT.  The extern "C" accessor gives the JIT session a stable unmangled symbol
// to look up; it returns the address of the XLA FFI handler JAX registers with
// `jax.ffi.register_ffi_target(..., platform="cpu")`.
//
// Placeholders:
//   @ROBOT_HEADER@  absolute path to the cricket-generated robot header
//   @FFI_HEADER@    absolute path to _fk_ffi.hh
//   @ROBOT_TYPE@    fully-qualified robot struct, e.g. vamp::robots::Ur5
//   @ROBOT_NAME@    lowercase token used as the handler symbol suffix

#include "@ROBOT_HEADER@"

#define VAMP_JAX_ROBOT @ROBOT_TYPE@
#define VAMP_JAX_ROBOT_NAME @ROBOT_NAME@

#include "@FFI_HEADER@"

#undef VAMP_JAX_ROBOT
#undef VAMP_JAX_ROBOT_NAME

extern "C" void *pyroffi_get_eefk() noexcept
{
    return reinterpret_cast<void *>(&eefk_@ROBOT_NAME@);
}
