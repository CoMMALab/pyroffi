    <disable_collisions link1="right_hand_index_1_link" link2="right_hand_palm_link" reason="Default"/>
    <disable_collisions link1="right_hand_index_1_link" link2="right_hand_thumb_2_link" reason="Default"/>
    <disable_collisions link1="right_hand_index_1_link" link2="right_hand_middle_0_link" reason="Default"/>
    <disable_collisions link1="right_hand_index_1_link" link2="right_hand_middle_1_link" reason="Default"/>
</robot>
