    <disable_collisions link1="right_wrist_roll_link" link2="right_wrist_yaw_link" reason="Adjacent"/>
    <disable_collisions link1="torso_link" link2="waist_support_link" reason="Adjacent"/>
    <!-- 43-DOF with-hand model. g1_29dof.srdf (above) has no hand links, and the spherized
         hand/wrist links touch or overlap at rest, which kept the self-collision penalty
         active at every pose. Disabled: pairs of links on the same hand/wrist that come within
         0.02 m (the solvers' largest default collision margin) at the zero, default or
         mid-limits pose. Arm-to-body and arm-to-arm pairs are left enabled. -->
    <disable_collisions link1="left_hand_palm_link" link2="left_wrist_pitch_link" reason="Default"/>
    <disable_collisions link1="left_hand_thumb_0_link" link2="left_wrist_pitch_link" reason="Default"/>
    <disable_collisions link1="left_hand_thumb_0_link" link2="left_wrist_yaw_link" reason="Default"/>
    <disable_collisions link1="left_hand_thumb_2_link" link2="left_hand_palm_link" reason="Default"/>
    <disable_collisions link1="left_hand_thumb_2_link" link2="left_hand_thumb_0_link" reason="Default"/>
    <disable_collisions link1="left_hand_middle_1_link" link2="left_hand_palm_link" reason="Default"/>
    <disable_collisions link1="left_hand_middle_1_link" link2="left_hand_thumb_2_link" reason="Default"/>
    <disable_collisions link1="left_hand_index_0_link" link2="left_hand_middle_0_link" reason="Default"/>
    <disable_collisions link1="left_hand_index_0_link" link2="left_hand_middle_1_link" reason="Default"/>
    <disable_collisions link1="left_hand_index_1_link" link2="left_hand_palm_link" reason="Default"/>
